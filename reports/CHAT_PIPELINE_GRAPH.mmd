    class USER,HOOK,UI_STATE,MEMORY_SAVE,SERVICE,UI_RENDER frontend
    class IPC_WRAP,SECURE_INVOKE,GUARD ipc
    class TAURI_CMD,PARSE_MODE,PARSE_PROVIDER,BUILD_REQUEST,ORCHESTRATOR,VALIDATE_EMPTY,MEASURE_LATENCY,BUILD_JSON backend
    class OMEGA_TRY,OMEGA_UNDERSTAND,OMEGA_RECALL,OMEGA_PLAN,OMEGA_SELECT,OMEGA_ACT,OMEGA_COMPOSE,OMEGA_TRACE,OMEGA_LEARN,OMEGA_SUCCESS,OMEGA_CONVERT omega
    class LEGACY_FALLBACK,LEGACY_1,LEGACY_PARALLEL,LEGACY_5,LEGACY_6,LEGACY_6_5,LEGACY_7,LEGACY_SUCCESS legacy
